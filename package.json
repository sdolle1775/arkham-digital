{
  "name": "arkham-horror-digital",
  "version": "0.4.5-audit.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.audit.json",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server/server/index.js",
    "catalog:sync": "tsx scripts/sync-catalog.ts",
    "assets:audit": "tsx scripts/audit-assets.ts",
    "package:windows": "node scripts/package-windows.mjs",
    "dev:pilot": "tsx watch src/server/index.ts --pilot",
    "audit:pin": "tsx scripts/pin-rules-audit.ts",
    "test:audit": "tsx scripts/test-audit.ts",
    "test:soak": "tsx scripts/test-soak.ts",
    "dev:audit": "tsx scripts/audit-browser-fixtures.ts",
    "test:package": "node scripts/smoke-windows-package.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "fflate": "^0.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
